{
  "info": {
    "name": "DOS Book Store",
    "description": "Import this collection. Book IDs 1-4 exist. Search topics: distributed systems, undergraduate school",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Catalog (8081)",
      "item": [
        {
          "name": "Info book 1",
          "request": {
            "method": "GET",
            "url": "http://localhost:8081/api/catalog/info/1"
          }
        },
        {
          "name": "Search distributed systems",
          "request": {
            "method": "GET",
            "url": "http://localhost:8081/api/catalog/search/distributed%20systems"
          }
        },
        {
          "name": "Update book 1 quantity",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 10,\n  \"price\": 40\n}"
            },
            "url": "http://localhost:8081/api/catalog/update/1"
          }
        }
      ]
    },
    {
      "name": "Order (8082)",
      "item": [
        {
          "name": "Purchase book 1",
          "request": {
            "method": "POST",
            "url": "http://localhost:8082/api/order/purchase/1"
          }
        }
      ]
    },
    {
      "name": "Frontend (8083) — use these in Postman",
      "item": [
        {
          "name": "Info book 1",
          "request": {
            "method": "GET",
            "url": "http://localhost:8083/frontend/info/1"
          }
        },
        {
          "name": "Search distributed systems",
          "request": {
            "method": "GET",
            "url": "http://localhost:8083/frontend/search/distributed%20systems"
          }
        },
        {
          "name": "Purchase book 1 (must be POST)",
          "request": {
            "method": "POST",
            "url": "http://localhost:8083/frontend/purchase/1"
          }
        }
      ]
    }
  ]
}
